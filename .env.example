# Clave de la API de Gemini (va solo en .env, nunca en el código)
GOOGLE_API_KEY=

# Claves de acceso: cada agente exige SU PROPIA clave en el encabezado X-API-Key.
# Inventen claves largas y distintas (ej.: python -c "import secrets; print(secrets.token_urlsafe(24))").
# En local conviven todas en este .env; en Heroku cada app tiene solo la suya.
CLAVE_PATO=clave-ficticia-pato
CLAVE_DANI=clave-ficticia-dani
CLAVE_CRISTIAN=clave-ficticia-cristian
# Clave del coordinador: la usan quienes le hablan (consola web, /chat, bot).
CLAVE_COORDINADOR=clave-ficticia-coordinador
# Solo si levantan los agentes de ejemplo de viajes y restaurantes.
CLAVE_VIAJES=
CLAVE_RESTAURANTES=

# Modelo de Gemini que usan los agentes
MODELO=gemini-3.5-flash-lite

# Dirección donde escucha el agente de viajes
URL_VIAJES=http://127.0.0.1:8000

# Dirección donde escucha el agente de restaurantes
URL_RESTAURANTES=http://127.0.0.1:8001

# Dirección donde escucha el coordinador
URL_COORDINADOR=http://127.0.0.1:8002

# Dirección donde escucha el Agente de Entrenamiento de Pato
URL_PATO=http://127.0.0.1:8005

# Dirección donde escucha el Agente de Maleta de Dani
URL_DANI=http://127.0.0.1:8003

# Dirección donde escucha el agente de sitios turísticos de Cristian
URL_CRISTIAN=http://127.0.0.1:8004

# URL HTTPS temporal para publicar la ficha del agente que expones (opcional)
URL_PUBLICA=

# URLs de los agentes que usa el coordinador, separadas por comas.
URLS_AGENTES=

# Clave de cada agente de URLS_AGENTES, en el MISMO orden y separadas por comas.
CLAVES_AGENTES=

# Tope de espera de la consola web al pedirle una respuesta a un agente (segundos)
TIEMPO_ESPERA_A2A=120

# Tope de espera al descargar la Agent Card de un agente (segundos).
# En Heroku usar 30: con el plan Eco las apps dormidas tardan 10-20 s en despertar.
TIEMPO_FICHA_A2A=3

# Cada cuántos segundos el coordinador vuelve a intentar un agente que no respondió
REINTENTO_AGENTES_SEG=60

# Token del bot de Telegram (@BotFather). Para probar en local, cada uno usa su propio bot de prueba.
TELEGRAM_TOKEN=

# Secreto del webhook de Telegram (distinto del token; nunca lo publiques)
TELEGRAM_SECRETO_WEBHOOK=

# IDs de Telegram que pueden usar el bot, separados por comas (tu ID te lo da @userinfobot)
TELEGRAM_USUARIOS_PERMITIDOS=

# Heroku: qué servidor levanta el Procfile en esta app (una app por agente).
# Ej.: src.agente_pato.server, src.agente_dani.server, src.agente_cristian.server o src.coordinador.server
APP_MODULO=src.agente_pato.server

# Heroku define PORT solo; en local solo se usa para probar el comando del Procfile.
PORT=8100
