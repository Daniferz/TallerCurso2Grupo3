# Clave de la API de Gemini (va solo en .env, nunca en el código)
GOOGLE_API_KEY=

# Modelo de Gemini que usan los tres agentes
MODELO=gemini-3.5-flash-lite

# Dirección donde escucha el agente de viajes
URL_VIAJES=http://127.0.0.1:8000

# Dirección donde escucha el agente de restaurantes
URL_RESTAURANTES=http://127.0.0.1:8001

# Dirección donde escucha el coordinador
URL_COORDINADOR=http://127.0.0.1:8002

# Tope de espera de la consola web al pedirle una respuesta a un agente (segundos)
TIEMPO_ESPERA_A2A=120

# Tope de espera al descargar la Agent Card de un agente (segundos)
TIEMPO_FICHA_A2A=3
